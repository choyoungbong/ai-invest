# AI INVEST 환경 변수
DATABASE_URL=postgresql+asyncpg://aiinvest:aiinvest@postgres:5432/aiinvest
REDIS_URL=redis://redis:6379/0

# 텔레그램 알림 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude AI 분석 (선택 – https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=

# 한국투자증권 오픈 API (Phase 5)
# https://apiportal.koreainvestment.com 에서 앱 등록 후 발급
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=12345678-01    # 계좌번호 (앞8자리-뒤2자리)
KIS_MOCK=true                  # true=모의투자, false=실전투자

# ──────────────────────────────────────────────────────────────────────────────
# [5] 거래 모드
#
#  ⚠️  SIMULATION_MODE 와 LIVE_MODE 는 반드시 쌍으로 변경할 것
#      모의:  SIMULATION_MODE=true  / LIVE_MODE=false
#      실전:  SIMULATION_MODE=false / LIVE_MODE=true
#
#  현재 SIMULATION_MODE=true / LIVE_MODE=true 로 설정되어 있으면
#  is_simulation 플래그 불일치로 매도 주문 실패 발생 (우리로 사태 원인)
# ──────────────────────────────────────────────────────────────────────────────

# ▼ 현재 활성 — 모의투자 ▼
SIMULATION_MODE=true                     # 모의: true  / 실전: false
LIVE_MODE=false                          # 모의: false / 실전: true
# ▲ 현재 활성 — 모의투자 ▲

# ▼ 실전 전환 시 주석 해제 ▼
# SIMULATION_MODE=false                 # ⚠️ 실전: false
# LIVE_MODE=true                        # ⚠️ 실전: true
# ▲ 실전 전환 시 주석 해제 ▲


# ──────────────────────────────────────────────────────────────────────────────
# [6] 시세 수집
# ──────────────────────────────────────────────────────────────────────────────
COLLECT_LIMIT=0                          # 0=전체 / 200=200개 제한(테스트용)
BREAKOUT_DAYS=20                         # N일 신고가 돌파 기준
VOLUME_MULTIPLIER=2.0                    # 거래대금 평균 대비 배수


# ──────────────────────────────────────────────────────────────────────────────
# [7] 자금 배분
# ──────────────────────────────────────────────────────────────────────────────
TOTAL_BUDGET=10000000                    # ⚠️ 총 투자 예산 (원) — 모의: 1000만 / 실전: 100만
ALLOC_BREAKOUT=0.40                      # 돌파매매 40%
ALLOC_MA_CROSS=0.30                      # MA 크로스 30%
ALLOC_RSI_REVERSAL=0.20                  # RSI 반등 20%
ALLOC_MACD=0.10                          # MACD 10%
MAX_SINGLE_TRADE_PCT=0.20                # 전략 예산 중 1회 최대 비율 20%


# ──────────────────────────────────────────────────────────────────────────────
# [8] 자동 매매 — 기본 설정
# ──────────────────────────────────────────────────────────────────────────────
AUTO_TRADE_ENABLED=true

# ▼ 종목당 투자금액 — 모의/실전 다름 ▼
MAX_AMOUNT_PER_STOCK=500000              # ⚠️ 모의: 50만원 / 실전 초기: 15만원 (예산의 15%)

TARGET_PROFIT_PCT=0.05                   # 익절 +5%
STOP_LOSS_PCT=-0.02                      # 손절 -2%
HARD_STOP_PCT=-0.03                      # 하드 손절 -3% (즉시 청산)
MAX_HOLD_DAYS=3                          # 최대 보유 기간 (일)


# ──────────────────────────────────────────────────────────────────────────────
# [9] 리스크 관리
# ──────────────────────────────────────────────────────────────────────────────

# ▼ 일일 손실 한도 — 모의/실전 다름 ▼
DAILY_LOSS_LIMIT=200000                  # ⚠️ 모의: 20만원 / 실전 초기: 2만원(예산의 2%)

# ▼ 동시 최대 보유 종목 — 모의/실전 다름 ▼
MAX_POSITIONS=10                         # ⚠️ 모의: 10개 / 실전 초기: 3개 권장

SLIPPAGE_LIMIT_PCT=0.005                 # 슬리피지 한도 0.5% 초과 시 주문 취소
BUY_COMMISSION=0.00015                   # 매수 수수료 0.015%
SELL_COMMISSION=0.00015                  # 매도 수수료 0.015%
DEFAULT_SLIPPAGE=0.0005                  # 기본 슬리피지 0.05%


# ──────────────────────────────────────────────────────────────────────────────
# [10] 장 운영 시간
# ──────────────────────────────────────────────────────────────────────────────
TRADE_START_HOUR=9
TRADE_START_MINUTE=5
TRADE_END_HOUR=15
TRADE_END_MINUTE=20


# ──────────────────────────────────────────────────────────────────────────────
# [11] 과매매 방지
# ──────────────────────────────────────────────────────────────────────────────
REENTRY_MINUTES=60                       # 동일 종목 재진입 제한 (분)
STOP_REENTRY_MINUTES=30                  # 손절 후 재진입 제한 (분)
MAX_DAILY_TRADES=10                      # ⚠️ 하루 최대 거래 횟수 10회 -> 5회
COOLTIME_HOURS=24                        # 쿨타임 (시간)
BLACKLIST_DAYS=3                         # ⚠️ 손절 후 블랙리스트 기간(일) 3일 -> 5일 (더 보수적)


# ──────────────────────────────────────────────────────────────────────────────
# [12] 분할매수
# ──────────────────────────────────────────────────────────────────────────────
SPLIT_BUY_ENABLED=true
SPLIT_BUY_RATIO=0.6                      # 1차 매수 비율 60%
SPLIT_BUY_TRIGGER_PCT=0.003              # 2차 매수 트리거 상승률 +0.3%
SPLIT_BUY_MIN_MINUTES=5                  # 1차 매수 후 최소 대기 5분
SPLIT_BUY_MAX_MINUTES=30                 # 2차 매수 유효 기간 30분 (초과 시 포기)
MAX_PHASE2_RISE_PCT=0.03                 # 2차 매수 급등 보호: +3% 초과 시 포기


# ──────────────────────────────────────────────────────────────────────────────
# [13] 신호 필터 (4중 필터)
# ──────────────────────────────────────────────────────────────────────────────
MIN_CONFIDENCE=0.55                      # ⚠️ 최소 신뢰도 (Claude AI 분석)   0.55 -> 0.65 (더 엄격한 신호만)
RSI_MIN=45                               # ⚠️ RSI 하한 (45 미만 신호 제외)   45 → 50 (더 확실한 상승 추세만)
RSI_MAX=78                               # ⚠️ RSI 상한 (78 초과 과매수 제외) 78 → 72 (과매수 구간 더 일찍 차단)
FILTER_RSI_ENABLED=true
FILTER_MACD_ENABLED=true
FILTER_MA_ENABLED=true
FILTER_BB_ENABLED=true
MARKET_FILTER_DAYS=5                     # 시장 추세 판단 기간 (일)


# ──────────────────────────────────────────────────────────────────────────────
# [14] 슬리피지 & 수수료
# ──────────────────────────────────────────────────────────────────────────────
# ※ [9] 리스크 관리 항목에 통합됨 (중복 제거)


### 설정 근거

#| 항목                   | 모의 | 실전 100만 | 이유                                                      |
#|------------------------|------|------------|-----------------------------------------------------------|
#| `MAX_AMOUNT_PER_STOCK` | 50만 | **15만**   | 100만 중 15% — 3종목 동시 보유 시 총 45만 사용, 55만 예비 |
#| `DAILY_LOSS_LIMIT`     | 20만 | **2만**    | 예산의 2% — 하루 최대 손실 2만원 초과 시 자동 중단        |
#| `MAX_POSITIONS`        | 10   | **3**      | 100만원에 10종목이면 종목당 10만, 수수료에 수익 묻힘      |
#| `MAX_DAILY_TRADES`     | 10   | **5**      | 과매매 방지, 초반 데이터 확인하며 천천히                  |
#| `MIN_CONFIDENCE`       | 0.55 | **0.65**   | Claude AI 신뢰도 기준 상향 — 애매한 신호 걸러냄           |
#| `BLACKLIST_DAYS`       | 3    | **5**      | 손절 종목 더 오래 차단                                    |



# ══════════════════════════════════════════════════════════════════════════════
#  실전 전환 체크리스트 (금요일 장 마감 후)
#
#  □ [4] KIS API: 모의 블록 주석 → 실전 블록 주석 해제
#  □ [5] 거래 모드: SIMULATION_MODE=false / LIVE_MODE=true
#  □ [7] TOTAL_BUDGET: 실제 입금액으로 수정
#  □ [8] MAX_AMOUNT_PER_STOCK: 20만원으로 낮춤
#  □ [9] DAILY_LOSS_LIMIT: 20000 (2만원)으로 낮춤
#  □ [9] MAX_POSITIONS: 3으로 낮춤
#  □ docker compose up -d --build
#  □ docker exec -it aiinvest-api python kis_verify/verify.py → ALL PASS
#  □ curl http://34.64.253.182:8000/trade/balance → 실전 잔고 확인
#  □ curl http://34.64.253.182:8000/risk/status → simulation_mode: false 확인
# ══════════════════════════════════════════════════════════════════════════════
