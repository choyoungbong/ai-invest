# ==============================================================================
# AI INVEST — 자동매매 시스템 환경변수 설정
# ==============================================================================
# ⚠️  이 파일은 절대 Git에 커밋하지 마세요 (.gitignore 확인 필수)
# ⚠️  모의투자 ↔ 실전투자 전환 시 [5] 거래 모드 섹션을 반드시 확인하세요
# ==============================================================================


# ──────────────────────────────────────────────────────────────────────────────
# [1] KIS API 인증 정보
# ──────────────────────────────────────────────────────────────────────────────
#KIS_APP_KEY=
#KIS_APP_SECRET=
#KIS_ACCOUNT_NO=     # 계좌번호 (앞8자리-뒤2자리)
#KIS_MOCK=true                  # 모의: true / 실전: false

# 실전
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=     # 계좌번호 (앞8자리-뒤2자리)
KIS_MOCK=                 # true=모의투자, false=실전투자

KIS_MAX_RETRIES=3                        # API 호출 실패 시 최대 재시도 횟수
KIS_RETRY_DELAY=1.0                      # 재시도 간 초기 대기 시간 (초, 지수 백오프 적용)


# ──────────────────────────────────────────────────────────────────────────────
# [2] 외부 서비스 API 키
# ──────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=             # 텔레그램 봇 토큰 (BotFather에서 발급)
TELEGRAM_CHAT_ID=                                                   # 알림 수신할 텔레그램 채팅 ID

ANTHROPIC_API_KEY=                       # Claude AI API 키 (신호 신뢰도 분석에 사용)


# ──────────────────────────────────────────────────────────────────────────────
# [3] 서버 / 인프라
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aiinvest:aiinvest@postgres:5432/aiinvest   # PostgreSQL 연결 문자열
REDIS_URL=redis://redis:6379/0                 # Redis 연결 문자열 (캐시·Rate Limit 용도)
NEXT_PUBLIC_API_URL=http://34.64.253.182:8000  # 대시보드가 호출하는 백엔드 API 주소


# ──────────────────────────────────────────────────────────────────────────────
# [4] 시세 수집
# ──────────────────────────────────────────────────────────────────────────────
COLLECT_LIMIT=0                          # 수집 종목 수 제한: 0=전체 / 200=200개 (테스트용)
BREAKOUT_DAYS=5                          # N일 신고가 돌파 기준 (기본 20 → 5일로 단축, 하락장 대응)
VOLUME_MULTIPLIER=2.0                    # 거래대금 진입 조건: 최근 평균 대비 N배 이상


# ──────────────────────────────────────────────────────────────────────────────
# [5] 거래 모드
# ──────────────────────────────────────────────────────────────────────────────
# ▼ 모의투자 사용 시 주석 해제 ▼
#SIMULATION_MODE=true                    # 모의투자: 실제 체결 없이 로직만 실행
#LIVE_MODE=false                         # 모의투자: KIS 모의투자 도메인 사용
# ▲ 모의투자 사용 시 주석 해제 ▲

# ▼ 실전투자 사용 시 주석 해제 ▼
SIMULATION_MODE=false                    # ⚠️ 실전: 실제 주문 체결됨
LIVE_MODE=true                           # ⚠️ 실전: KIS 실전 도메인 사용
# ▲ 실전투자 사용 시 주석 해제 ▲


# ──────────────────────────────────────────────────────────────────────────────
# [6] 자금 배분
# ──────────────────────────────────────────────────────────────────────────────
TOTAL_BUDGET=3000000                     # ⚠️ 총 투자 예산 (원): 모의 1,000만 / 실전 300만
ALLOC_BREAKOUT=0.40                      # 돌파매매 전략 예산 비율 40%
ALLOC_MA_CROSS=0.30                      # MA 크로스 전략 예산 비율 30%
ALLOC_RSI_REVERSAL=0.20                  # RSI 반등 전략 예산 비율 20%
ALLOC_MACD=0.10                          # MACD 전략 예산 비율 10%
MAX_SINGLE_TRADE_PCT=0.20                # 전략 예산 중 1회 주문의 최대 비율 (20%)


# ──────────────────────────────────────────────────────────────────────────────
# [7] 자동매매 — 기본 설정
# ──────────────────────────────────────────────────────────────────────────────
AUTO_TRADE_ENABLED=true                  # 자동 주문 실행 여부: true=활성 / false=신호만 발생

MAX_AMOUNT_PER_STOCK=750000              # ⚠️ 종목당 최대 투자금액: 모의 50만 / 실전 초기 15만 권장
TARGET_PROFIT_PCT=0.05                   # 고정 익절 목표 수익률 (+5%), 트레일링 스탑 비활성 시 사용
STOP_LOSS_PCT=-0.015                     # 일반 손절 기준 (-1.5%), 초과 시 시장가 매도
HARD_STOP_PCT=-0.025                     # 하드 손절 기준 (-2.5%), STOP_LOSS보다 우선 적용 (즉시 청산)
MAX_HOLD_DAYS=3                          # 수익/손실 무관 강제 청산 최대 보유 기간 (일)


# ──────────────────────────────────────────────────────────────────────────────
# [8] 리스크 관리
# ──────────────────────────────────────────────────────────────────────────────
DAILY_LOSS_LIMIT=60000                   # ⚠️ 일일 최대 허용 손실액: 모의 20만 / 실전 6만 (예산의 2%)
                                         #    초과 시 당일 신규 매수 전면 차단 (재시작해도 DB 기반 복원)

MAX_POSITIONS=4                          # ⚠️ 동시 최대 보유 종목 수: 모의 10개 / 실전 초기 3개 권장

SLIPPAGE_LIMIT_PCT=0.03                  # 신호가 대비 현재가 허용 슬리피지 (3%, 급락장 대응으로 완화)
BUY_COMMISSION=0.00015                   # 매수 수수료율 (0.015%, KIS 기준)
SELL_COMMISSION=0.00015                  # 매도 수수료율 (0.015%, KIS 기준)
DEFAULT_SLIPPAGE=0.0005                  # 순손익 계산 시 기본 슬리피지 가정치 (0.05%)


# ──────────────────────────────────────────────────────────────────────────────
# [9] 장 운영 시간 (KST 기준)
# ──────────────────────────────────────────────────────────────────────────────
TRADE_START_HOUR=9                       # 매매 시작 시각: 시 (기본 09:05)
TRADE_START_MINUTE=5                     # 매매 시작 시각: 분
TRADE_END_HOUR=15                        # 매매 종료 시각: 시 (기본 15:20)
TRADE_END_MINUTE=20                      # 매매 종료 시각: 분


# ──────────────────────────────────────────────────────────────────────────────
# [10] 과매매 방지
# ──────────────────────────────────────────────────────────────────────────────
REENTRY_MINUTES=120                      # 동일 종목 일반 재진입 금지 시간 (분)
STOP_REENTRY_MINUTES=90                  # 동일 종목 손절 후 재진입 금지 시간 (분, 일반보다 강화)
MAX_DAILY_TRADES=5                       # ⚠️ 하루 최대 신규 매수 횟수 (1차 진입 기준, 2차 분할매수 미포함)
COOLTIME_HOURS=24                        # 손절 후 동일 종목 재매수 금지 시간 (시간, 블랙리스트와 별도)
BLACKLIST_DAYS=5                         # ⚠️ 손절 청산 후 블랙리스트 등록 기간 (일): 3일 → 5일로 강화


# ──────────────────────────────────────────────────────────────────────────────
# [11] 분할매수
# ──────────────────────────────────────────────────────────────────────────────
SPLIT_BUY_ENABLED=true                   # 분할매수 활성화 여부
SPLIT_BUY_RATIO=0.6                      # 1차 매수 비율 (60%, 나머지 40%는 2차에 사용)
SPLIT_BUY_TRIGGER_PCT=0.003              # 2차 매수 트리거 조건: 1차 매수가 대비 +0.3% 이상 상승 시
SPLIT_BUY_MIN_MINUTES=5                  # 2차 매수 최소 대기 시간: 1차 매수 후 N분 경과 필요
SPLIT_BUY_MAX_MINUTES=30                 # 2차 매수 유효 시간: 이 시간 초과 시 2차 매수 포기
MAX_PHASE2_RISE_PCT=0.03                 # 2차 매수 급등 보호: 1차 대비 +3% 초과 급등 시 2차 포기


# ──────────────────────────────────────────────────────────────────────────────
# [12] 청산 전략 — 트레일링 스탑
# ──────────────────────────────────────────────────────────────────────────────
# 수익이 ACTIVATION 수준에 도달하면 고정 익절 대신 트레일링 모드로 전환.
# 이후 가격이 고점 대비 TRAILING_STOP_PCT 이하로 내려오면 즉시 청산.
# 예) 평균매수가 10,000원 → +3%(10,300원) 도달 → 트레일링 활성
#     10,500원 고점 갱신 → 청산선 = 10,500 × (1 - 0.015) = 10,343원
#     10,340원 하락 → 청산선 이탈 → 매도! (+3.4% 수익 확정)
TRAILING_STOP_ENABLED=true               # 트레일링 스탑 활성화 여부 (true 권장)
TRAILING_STOP_ACTIVATION_PCT=0.03        # 트레일링 모드 전환 수익률 기준 (+3%)
TRAILING_STOP_PCT=0.015                  # 고점 대비 허용 하락폭 (1.5%, 이탈 시 청산)


# ──────────────────────────────────────────────────────────────────────────────
# [13] 신호 필터 (4중 기술 지표 필터 + AI 신뢰도)
# ──────────────────────────────────────────────────────────────────────────────
MIN_CONFIDENCE=0.55                      # Claude AI 신호 최소 신뢰도 (0~1.0, 높을수록 엄격)
MIN_CHANGE_RATE=0.3                      # 진입 최소 등락률 (%): 2.0 → 0.3으로 완화 (신호 빈도 증가)

RSI_MIN=45                               # RSI 하한: 이 값 미만 신호 제외 (모멘텀 부족 구간)
RSI_MAX=80                               # RSI 상한: 이 값 초과 신호 제외 (과매수 구간)
FILTER_RSI_ENABLED=true                  # RSI 필터 활성화 여부

FILTER_MACD_ENABLED=true                 # MACD 히스토그램 양수 조건 필터 활성화 여부
FILTER_MA_ENABLED=false                  # MA 골든크로스 필터 활성화 여부 (현재 비활성, 신호 과소 방지)
FILTER_BB_ENABLED=true                   # 볼린저밴드 중심선 위 조건 필터 활성화 여부

MARKET_FILTER_DAYS=3                     # 시장 추세 판단 기간 (일): MA20 + 최근 N일 수익률로 판단


# ──────────────────────────────────────────────────────────────────────────────
# [14] 외국인/기관 수급 필터
# ──────────────────────────────────────────────────────────────────────────────
# ⚠️  KIS 실전 계정에서만 유효한 데이터입니다. KIS_MOCK=true 시 false로 설정하세요.
# 점수 기준:
#   0.0 = 외국인·기관 모두 순매도
#   0.5 = 외국인 또는 기관 중 하나만 순매수
#   1.0 = 외국인 + 기관 모두 순매수
FILTER_INVESTOR_FLOW_ENABLED=true        # 수급 필터 활성화 여부 (실전에서 true 권장)
INVESTOR_SCORE_MIN=0.3                   # 통과 최소 수급 점수 (초기: 0.3 / 이후 0.5~1.0으로 상향 권장)


# ──────────────────────────────────────────────────────────────────────────────
# [15] 오후 진입 제한
# ──────────────────────────────────────────────────────────────────────────────
# 14:00~14:29: 아래 조건을 모두 만족하는 신호만 허용 (당일 청산 시간 부족 대응)
# 14:30 이후 : 신규 진입 전면 차단 (익일 갭다운 리스크 방지)
AFTERNOON_MIN_CONFIDENCE=0.65            # 14:00~14:29 허용 최소 AI 신뢰도 (일반 기준보다 엄격)
AFTERNOON_MIN_CHANGE=1.5                 # 14:00~14:29 허용 최소 등락률 (%, 강한 모멘텀 신호만)
